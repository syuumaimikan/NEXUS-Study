<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/formula_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="NEXUS Icon" />

        <TextView
            android:id="@+id/widget_formula_subject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="【数学】本日の重要公式"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="必修"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E293B"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/widget_formula_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="積分の1/6公式 (放物線と直線の面積)"
        android:textColor="#94A3B8"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_formula_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="S = (|a| / 6) * (β - α)³"
        android:textColor="#FBBF24"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/widget_formula_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="タップして全教科公式集を開く"
        android:textColor="#34D399"
        android:textSize="10sp"
        android:layout_marginTop="4dp" />
</LinearLayout>
